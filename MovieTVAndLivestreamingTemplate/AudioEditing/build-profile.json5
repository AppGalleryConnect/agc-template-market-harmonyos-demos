{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "5.0.5(17)",
        "compatibleSdkVersion": "5.0.3(15)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./products/entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "common",
      "srcPath": "./commons/common"
    },
    {
      "name": "person",
      "srcPath": "./features/person"
    },
    {
      "name": "aggregated_login",
      "srcPath": "./components/aggregated_login"
    },
    {
      "name": "oh_router",
      "srcPath": "./commons/oh_router"
    },
    {
      "name": "check_app_update",
      "srcPath": "./components/check_app_update"
    },
    {
      "name": "collect_personal_info",
      "srcPath": "./components/collect_personal_info"
    },
    {
      "name": "vip_center",
      "srcPath": "./components/vip_center"
    },
    {
      "name": "base_apis",
      "srcPath": "./components/base_apis"
    },
    {
      "name": "aggregated_payment",
      "srcPath": "./components/aggregated_payment"
    },
    {
      "name": "audio_edit_home",
      "srcPath": "./features/audio_edit_home"
    },
    {
      "name": "audio_work_list",
      "srcPath": "./features/audio_work_list"
    },
    {
      "name": "audio_adjust_speed",
      "srcPath": "./components/audio_adjust_speed"
    },
    {
      "name": "audio_crop",
      "srcPath": "./components/audio_crop"
    },
    {
      "name": "audio_adjust_tone",
      "srcPath": "./components/audio_adjust_tone"
    },
    {
      "name": "audio_common",
      "srcPath": "./components/audio_common"
    },
    {
      "name": "audio_worker",
      "srcPath": "./components/audio_worker",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "audio_format_conversion",
      "srcPath": "./components/audio_format_conversion"
    },
    {
      "name": "common_view",
      "srcPath": "./components/common_view"
    },
    {
      "name": "audio_extraction",
      "srcPath": "./components/audio_extraction"
    },
    {
      "name": "audio_synthesis",
      "srcPath": "./components/audio_synthesis"
    }
  ]
}