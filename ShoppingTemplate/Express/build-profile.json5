{
  "app": {
/*
        :todo 补充手动签名
        */
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "6.0.2(22)",
        "compatibleSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./products/entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "lib_foundation",
      "srcPath": "./commons/lib_foundation"
    },
    {
      "name": "business_home",
      "srcPath": "./features/business_home"
    },
    {
      "name": "business_order",
      "srcPath": "./features/business_order"
    },
    {
      "name": "business_mine",
      "srcPath": "./features/business_mine"
    },
    {
      "name": "module_template",
      "srcPath": "./components/module_template"
    },
    {
      "name": "module_auth",
      "srcPath": "./components/module_auth"
    },
    {
      "name": "membership",
      "srcPath": "./components/membership"
    },
    {
      "name": "module_advertisement",
      "srcPath": "./components/module_advertisement"
    },
    {
      "name": "address_management",
      "srcPath": "./components/address_management"
    },
    {
      "name": "coupons",
      "srcPath": "./components/coupons"
    },
    {
      "name": "collect_personal_info",
      "srcPath": "./components/collect_personal_info"
    },
    {
      "name": "aggregated_login",
      "srcPath": "./components/aggregated_login"
    },
    {
      "name": "aggregated_payment",
      "srcPath": "./components/aggregated_payment"
    },
    {
      "name": "notice_center",
      "srcPath": "./components/notice_center"
    },
    {
      "name": "feedback",
      "srcPath": "./components/feedback"
    },
    {
      "name": "app_setting",
      "srcPath": "./components/app_setting"
    },
    {
      "name": "business_benefits",
      "srcPath": "./features/business_benefits"
    }
  ]
}